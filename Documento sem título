// ==================== MÓDULO DE ATIVOS ====================
function cadastrarAtivo(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Ativos');
  if (!planilha) return { sucesso: false, erro: 'Aba Ativos não encontrada' };

  const idEmpresaAtual = String(dados.idEmpresa || '').trim();
  const modeloNovo = String(dados.modelo || '').trim().toUpperCase();
  const ativoNovo = String(dados.ativo || '').trim();

  if (!idEmpresaAtual || !modeloNovo || !ativoNovo) {
    return { sucesso: false, erro: 'Preencha o modelo e o número do ativo.' };
  }

  // Validação: Verificar se já existe um ativo com o mesmo número para esta empresa
  const ultimaLinha = planilha.getLastRow();
  if (ultimaLinha >= 2) {
    const valores = planilha.getRange(2, 1, ultimaLinha - 1, 4).getValues();
    for (let i = 0; i < valores.length; i++) {
      const empresaRow = String(valores[i][1] || '').trim(); // Coluna B: idEmpresa
      const ativoCadastrado = String(valores[i][3] || '').replace(/^['"]/, '').trim(); // Coluna D: ativo
      
      if (empresaRow === idEmpresaAtual && ativoCadastrado === ativoNovo) {
        return { sucesso: false, erro: '❌ Já existe um ativo cadastrado com este número (Ativo) para esta empresa!' };
      }
    }
  }

  const idAtivo = Date.now();
  planilha.appendRow([
    idAtivo, 
    idEmpresaAtual,
    modeloNovo, 
    "'" + ativoNovo, 
    dados.tipoMedicao || 'Horas', 
    dados.leituraAtual ? Number(dados.leituraAtual) : 0,
    converterLinkDrive(dados.foto1 || ''),
    converterLinkDrive(dados.foto2 || ''),
    converterLinkDrive(dados.foto3 || ''),
    converterLinkDrive(dados.foto4 || '')
  ]);
  
  forcarTextoPreto(planilha);
  return { sucesso: true, id: idAtivo };
}

function listarAtivos(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Ativos');
  if (!planilha) return { sucesso: false, erro: 'Aba Ativos não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  const ativos = [];
  const idEmpresaFiltro = dados && dados.idEmpresa ? String(dados.idEmpresa) : null;

  for (let i = 1; i < linhas.length; i++) {
    const linha = linhas[i];
    if (!linha[0]) continue;

    const idEmpresaLinha = String(linha[1] || '');
    if (idEmpresaFiltro && idEmpresaFiltro !== '' && idEmpresaLinha !== idEmpresaFiltro) {
      continue;
    }

    ativos.push({
      id: linha[0],
      idEmpresa: idEmpresaLinha,
      modelo: linha[2] || 'SEM MODELO',
      ativo: String(linha[3] || '').replace(/^['"]/, '').trim(),
      tipoMedicao: linha[4] || 'Horas',
      leituraAtual: linha[5] !== undefined ? linha[5] : 0,
      foto1: converterLinkDrive(linha[6] || ''),
      foto2: converterLinkDrive(linha[7] || ''),
      foto3: converterLinkDrive(linha[8] || ''),
      foto4: converterLinkDrive(linha[9] || '')
    });
  }

  return { sucesso: true, ativos: ativos };
}

function atualizarAtivo(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Ativos');
  if (!planilha) return { sucesso: false, erro: 'Aba Ativos não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  for (let i = 1; i < linhas.length; i++) {
    if (String(linhas[i][0]) === String(dados.id)) {
      const rowNum = i + 1;
      if (dados.modelo) planilha.getRange(rowNum, 3).setValue(String(dados.modelo).toUpperCase());
      if (dados.ativo) planilha.getRange(rowNum, 4).setValue("'" + String(dados.ativo).trim());
      if (dados.tipoMedicao) planilha.getRange(rowNum, 5).setValue(dados.tipoMedicao);
      if (dados.leituraAtual !== undefined) planilha.getRange(rowNum, 6).setValue(Number(dados.leituraAtual));
      if (dados.foto1 !== undefined) planilha.getRange(rowNum, 7).setValue(converterLinkDrive(dados.foto1));
      if (dados.foto2 !== undefined) planilha.getRange(rowNum, 8).setValue(converterLinkDrive(dados.foto2));
      if (dados.foto3 !== undefined) planilha.getRange(rowNum, 9).setValue(converterLinkDrive(dados.foto3));
      if (dados.foto4 !== undefined) planilha.getRange(rowNum, 10).setValue(converterLinkDrive(dados.foto4));

      forcarTextoPreto(planilha);
      return { sucesso: true };
    }
  }
  return { sucesso: false, erro: 'Ativo não encontrado para atualização' };
}

function deletarAtivo(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Ativos');
  if (!planilha) return { sucesso: false, erro: 'Aba Ativos não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  for (let i = 1; i < linhas.length; i++) {
    if (String(linhas[i][0]) === String(dados.id)) {
      planilha.deleteRow(i + 1);
      return { sucesso: true };
    }
  }
  return { sucesso: false, erro: 'Ativo não encontrado para exclusão' };
}


// ==================== MÓDULO DE ORDENS DE SERVIÇO (OS) ====================
