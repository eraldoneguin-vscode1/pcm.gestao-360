/**
 * ARQUIVO: Código.gs
 * Sistema: PCM360 - Gestão de Manutenção
 * Descrição: Centralizador doPost e rotas completas (CRUD) para Empresas, Setores, Funcionários, Ativos, OS e Login.
 */

function doPost(e) {
  try {
    const dados = JSON.parse(e.postData.contents);
    const acao = dados.acao;
    let resultado = { sucesso: false, erro: 'Ação desconhecida ou não especificada' };

    switch (acao) {
      // ================= LOGIN =================
      case 'fazerLogin':
        resultado = fazerLogin(dados);
        break;

      // ================= EMPRESAS =================
      case 'cadastrarEmpresa':
        resultado = cadastrarEmpresa(dados);
        break;
      case 'listarEmpresas':
        resultado = listarEmpresas();
        break;
      case 'atualizarEmpresa':
        resultado = atualizarEmpresa(dados);
        break;
      case 'alternarStatusEmpresa':
        resultado = alternarStatusEmpresa(dados);
        break;
      case 'deletarEmpresa':
        resultado = deletarEmpresa(dados);
        break;

      // ================= SETORES =================
      case 'cadastrarSetor':
        resultado = cadastrarSetor(dados);
        break;
      case 'listarSetores':
        resultado = listarSetores(dados);
        break;
      case 'atualizarSetor':
        resultado = atualizarSetor(dados);
        break;
      case 'deletarSetor':
        resultado = deletarSetor(dados);
        break;

      // ================= FUNCIONÁRIOS =================
      case 'cadastrarFuncionario':
        resultado = cadastrarFuncionario(dados);
        break;
      case 'listarFuncionarios':
        resultado = listarFuncionarios(dados);
        break;
      case 'atualizarFuncionario':
        resultado = atualizarFuncionario(dados);
        break;
      case 'deletarFuncionario':
        resultado = deletarFuncionario(dados);
        break;

      // ================= ATIVOS =================
      case 'cadastrarAtivo':
        resultado = cadastrarAtivo(dados);
        break;
      case 'listarAtivos':
        resultado = listarAtivos(dados);
        break;
      case 'atualizarAtivo':
        resultado = atualizarAtivo(dados);
        break;
      case 'deletarAtivo':
        resultado = deletarAtivo(dados);
        break;

      // ================= ORDENS DE SERVIÇO (OS) =================
      case 'cadastrarOS':
        resultado = cadastrarOS(dados);
        break;
      case 'listarOS':
        resultado = listarOS(dados);
        break;
      case 'atualizarOS':
        resultado = atualizarOS(dados);
        break;
      case 'atualizarStatusOS':
        resultado = atualizarStatusOS(dados);
        break;
      case 'deletarOS':
        resultado = deletarOS(dados);
        break;

      default:
        resultado = { sucesso: false, erro: `Ação inválida: ${acao}` };
    }

    return ContentService.createTextOutput(JSON.stringify(resultado))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (erro) {
    return ContentService.createTextOutput(JSON.stringify({ sucesso: false, erro: erro.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function doGet(e) {
  return ContentService.createTextOutput(JSON.stringify({ status: "API PCM360 Rodando com Sucesso!" }))
    .setMimeType(ContentService.MimeType.JSON);
}


// ==================== MÓDULO DE LOGIN ====================
function fazerLogin(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Empresas');
  if (!planilha) return { sucesso: false, erro: 'Aba Empresas não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  const usuarioInput = String(dados.usuario || '').trim();
  const senhaInput = String(dados.senha || '').trim();

  for (let i = 1; i < linhas.length; i++) {
    const linha = linhas[i];
    const idEmpresa = String(linha[0] || '');
    const nomeEmpresa = String(linha[1] || '');
    const usuarioSalvo = String(linha[6] || '').trim();
    const senhaSalva = String(linha[7] || '').trim();
    const statusEmpresa = String(linha[9] || 'Ativo').trim();

    if (usuarioSalvo.toLowerCase() === usuarioInput.toLowerCase() && senhaSalva === senhaInput) {
      
      if (statusEmpresa.toLowerCase() === 'pausado') {
        return { sucesso: false, erro: 'Esta empresa está com o acesso pausado. Contacte o suporte.' };
      }

      return {
        sucesso: true,
        id: idEmpresa,
        nome: nomeEmpresa,
        cargo: 'empresa'
      };
    }
  }

  return { sucesso: false, erro: 'Usuário ou senha incorretos.' };
}


// ==================== MÓDULO DE EMPRESAS ====================
function cadastrarEmpresa(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Empresas');
  if (!planilha) return { sucesso: false, erro: 'Aba Empresas não encontrada' };

  const idEmpresa = 'EMP_' + Date.now();
  const cnpjLimpo = String(dados.cnpj || '').replace(/\D/g, '');
  
  const sufixoUser = cnpjLimpo.length >= 4 ? cnpjLimpo.slice(-6) : Math.floor(100000 + Math.random() * 900000);
  const usuarioGerado = 'emp_' + sufixoUser;
  const senhaProvisoria = Math.random().toString(36).slice(-8);

  planilha.appendRow([
    idEmpresa, 
    dados.nomeEmpresa || dados.nome || '', 
    dados.cnpj || '', 
    dados.estado || '', 
    dados.cidade || '', 
    dados.limiteIds || dados.qtId || '', 
    usuarioGerado, 
    senhaProvisoria,
    converterLinkDrive(dados.linkImagem || ''),
    'Ativo'
  ]);

  forcarTextoPreto(planilha);

  return { 
    sucesso: true, 
    idEmpresa: idEmpresa, 
    usuario: usuarioGerado, 
    senhaProvisoria: senhaProvisoria 
  };
}

function listarEmpresas() {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Empresas');
  if (!planilha) return { sucesso: false, erro: 'Aba Empresas não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  const empresas = [];

  for (let i = 1; i < linhas.length; i++) {
    const linha = linhas[i];
    if (!linha[0]) continue;
    empresas.push({
      idEmpresa: linha[0],
      nomeEmpresa: linha[1],
      cnpj: linha[2],
      estado: linha[3],
      cidade: linha[4],
      limiteIds: linha[5],
      usuario: linha[6],
      senha: linha[7],
      linkImagem: converterLinkDrive(linha[8] || ''),
      status: linha[9] || 'Ativo'
    });
  }
  return { sucesso: true, empresas: empresas };
}

function atualizarEmpresa(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Empresas');
  if (!planilha) return { sucesso: false, erro: 'Aba Empresas não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  for (let i = 1; i < linhas.length; i++) {
    if (String(linhas[i][0]) === String(dados.idEmpresa)) {
      const rowNum = i + 1;
      if (dados.nomeEmpresa || dados.nome) planilha.getRange(rowNum, 2).setValue(dados.nomeEmpresa || dados.nome);
      if (dados.cnpj) planilha.getRange(rowNum, 3).setValue(dados.cnpj);
      if (dados.estado) planilha.getRange(rowNum, 4).setValue(dados.estado);
      if (dados.cidade) planilha.getRange(rowNum, 5).setValue(dados.cidade);
      if (dados.limiteIds !== undefined || dados.qtId !== undefined) planilha.getRange(rowNum, 6).setValue(dados.limiteIds || dados.qtId);
      if (dados.linkImagem !== undefined) planilha.getRange(rowNum, 9).setValue(converterLinkDrive(dados.linkImagem));
      
      forcarTextoPreto(planilha);
      return { sucesso: true };
    }
  }
  return { sucesso: false, erro: 'Empresa não encontrada para atualização' };
}

function alternarStatusEmpresa(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Empresas');
  if (!planilha) return { sucesso: false, erro: 'Aba Empresas não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  for (let i = 1; i < linhas.length; i++) {
    if (String(linhas[i][0]) === String(dados.idEmpresa)) {
      const rowNum = i + 1;
      const novoStatus = dados.status || 'Ativo';
      planilha.getRange(rowNum, 10).setValue(novoStatus);

      forcarTextoPreto(planilha);
      return { sucesso: true, novoStatus: novoStatus };
    }
  }
  return { sucesso: false, erro: 'Empresa não encontrada para alterar status' };
}

function deletarEmpresa(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Empresas');
  if (!planilha) return { sucesso: false, erro: 'Aba Empresas não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  for (let i = 1; i < linhas.length; i++) {
    if (String(linhas[i][0]) === String(dados.idEmpresa)) {
      planilha.deleteRow(i + 1);
      return { sucesso: true };
    }
  }
  return { sucesso: false, erro: 'Empresa não encontrada para exclusão' };
}


