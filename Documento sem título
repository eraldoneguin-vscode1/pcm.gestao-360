  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('OrdensServico');
  if (!planilha) return { sucesso: false, erro: 'Aba OrdensServico não encontrada!' };

  const idOS = Date.now();
  const dataAbertura = new Date().toLocaleDateString('pt-BR');

  planilha.appendRow([
    idOS,
    dados.idEmpresa || '',
    dados.setores || dados.setor || '',
    dados.prioridade || 'Normal',
    dados.equipamento || '',
    dados.funcionario || '',
    dados.descricao || '',
    dados.pecas || '',
    dados.observacao || '', 
    'Aberta', 
    dataAbertura
  ]);

  forcarTextoPreto(planilha);
  return { sucesso: true, id: idOS };
}

function listarOS(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('OrdensServico');
  if (!planilha) return { sucesso: false, erro: 'Aba OrdensServico não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  const ordens = [];
  const idEmpresaFiltro = dados && dados.idEmpresa ? String(dados.idEmpresa) : null;

  for (let i = 1; i < linhas.length; i++) {
    const linha = linhas[i];
    if (!linha[0]) continue;

    const idEmpresaLinha = String(linha[1] || '');
    if (idEmpresaFiltro && idEmpresaFiltro !== '' && idEmpresaLinha !== idEmpresaFiltro) {
      continue;
    }

    ordens.push({
      id: linha[0],
      idEmpresa: idEmpresaLinha,
      setor: linha[2],
      prioridade: linha[3],
      equipamento: linha[4],
      funcionario: linha[5],
      descricao: linha[6],
      pecas: linha[7],
      observacao: linha[8],
      status: linha[9],
      dataAbertura: linha[10]
    });
  }

  return { sucesso: true, ordens: ordens };
}

function atualizarOS(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('OrdensServico');
  if (!planilha) return { sucesso: false, erro: 'Aba OrdensServico não encontrada' };

  const linhas = planilha.getDataRange().getValues();
  for (let i = 1; i < linhas.length; i++) {
    if (String(linhas[i][0]) === String(dados.id)) {
      const rowNum = i + 1;
      if (dados.setor || dados.setores) planilha.getRange(rowNum, 3).setValue(dados.setor || dados.setores);
      if (dados.prioridade) planilha.getRange(rowNum, 4).setValue(dados.prioridade);
      if (dados.equipamento) planilha.getRange(rowNum, 5).setValue(dados.equipamento);
      if (dados.funcionario) planilha.getRange(rowNum, 6).setValue(dados.funcionario);
      if (dados.descricao) planilha.getRange(rowNum, 7).setValue(dados.descricao);
      if (dados.pecas !== undefined) planilha.getRange(rowNum, 8).setValue(dados.pecas);
      if (dados.observacao !== undefined) planilha.getRange(rowNum, 9).setValue(dados.observacao);
      if (dados.status) planilha.getRange(rowNum, 10).setValue(dados.status);

      forcarTextoPreto(planilha);
      return { sucesso: true };
    }
  }
  return { sucesso: false, erro: 'OS não encontrada para atualização' };
}

