// ==================== MÓDULO DE FUNCIONÁRIOS (OTIMIZADO) ====================
function cadastrarFuncionario(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Funcionario');
  if (!planilha) return { sucesso: false, erro: 'Aba Funcionario não encontrada' };

  const idEmpresaAtual = String(dados.idEmpresa || '').trim();
  const nomeNovo = String(dados.nome || '').trim().toUpperCase();
  const matriculaNova = String(dados.matricula || '').trim();
  const setorNovo = String(dados.setor || '').trim();
  const cargoNovo = String(dados.cargo || '').trim();
  const fotoNova = String(dados.foto || '').trim();

  if (!idEmpresaAtual || !nomeNovo || !matriculaNova || !setorNovo || !cargoNovo || !fotoNova) {
    return { sucesso: false, erro: 'Preencha todos os 5 campos obrigatórios: Nome, Matrícula, Setor, Cargo e Foto.' };
  }

  if (!/^\d+$/.test(matriculaNova) || matriculaNova.length > 6) {
    return { sucesso: false, erro: 'A matrícula deve conter apenas números e no máximo 6 dígitos!' };
  }

  const ultimaLinha = planilha.getLastRow();
  
  if (ultimaLinha >= 2) {
    const valores = planilha.getRange(2, 1, ultimaLinha - 1, 4).getValues();
    for (let i = 0; i < valores.length; i++) {
      const empresaRow = String(valores[i][0] || '').trim();
      const matriculaCadastrada = String(valores[i][3] || '').trim();
      
      if (empresaRow === idEmpresaAtual && matriculaCadastrada === matriculaNova) {
        return { sucesso: false, erro: 'Já existe um funcionário cadastrado com esta Matrícula!' };
      }
    }
  }

  const idFunc = Date.now();
  const usuarioGerado = 'func_' + matriculaNova;
  const senhaGerada = Math.random().toString(36).slice(-6).toUpperCase();

  planilha.appendRow([
    idEmpresaAtual,
    idFunc, 
    nomeNovo, 
    matriculaNova, 
    setorNovo, 
    cargoNovo,
    converterLinkDrive(fotoNova),
    usuarioGerado,
    senhaGerada
  ]);
  
  forcarTextoPreto(planilha);
  
  return { 
    sucesso: true, 
    id: idFunc, 
    usuario: usuarioGerado, 
    senha: senhaGerada 
  };
}

function listarFuncionarios(dados) {
  const planilha = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Funcionario');
  if (!planilha) return { sucesso: false, erro: 'Aba Funcionario não encontrada' };

  const ultimaLinha = planilha.getLastRow();
  if (ultimaLinha < 2) return { sucesso: true, funcionarios: [] };

  const valores = planilha.getRange(2, 1, ultimaLinha - 1, 7).getValues();
  const funcionarios = [];
  const idEmpresaBuscada = dados && dados.idEmpresa ? String(dados.idEmpresa).trim() : '';

  for (let i = 0; i < valores.length; i++) {
    const row = valores[i];
    const idEmpresaPlanilha = String(row[0] || '').trim();
    
    if (idEmpresaBuscada && idEmpresaPlanilha === idEmpresaBuscada) {
      funcionarios.push({
        id: row[1],
        nome: row[2],
        matricula: row[3],
        setor: row[4],
        cargo: row[5],
        foto: converterLinkDrive(row[6] || '')
      });
    }
  }

  return { sucesso: true, funcionarios: funcionarios };
}

