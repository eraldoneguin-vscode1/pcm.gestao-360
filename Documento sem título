function converterLinkDrive(url) {
  if (!url || typeof url !== 'string') return '';
  const match = url.match(/\/file\/d\/([a-zA-Z0-9_-]+)/) || url.match(/id=([a-zA-Z0-9_-]+)/);
  if (match && match[1]) {
    return `https://lh3.googleusercontent.com/d/${match[1]}=s1000`;
  }
  return url;
}

function forcarTextoPreto(planilha) {
  const ultimaLinha = planilha.getLastRow();
  const ultimaColuna = planilha.getLastColumn();
  if (ultimaLinha > 1 && ultimaColuna > 0) {
    planilha.getRange(2, 1, ultimaLinha - 1, ultimaColuna).setFontColor('#000000');
  }
}
